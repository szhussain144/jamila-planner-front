# Backend API base URL.
# Leave empty in local dev: /api requests are proxied to DEV_API_PROXY by Vite.
# In production set it to your API domain, e.g. https://api.yourpractice.com
# (and add this frontend's URL to the backend's FRONTEND_URL / CORS_ORIGINS).
VITE_API_URL=

# Dev only: where Vite forwards /api when VITE_API_URL is empty
DEV_API_PROXY=http://localhost:4000
